QMainWindow {
    background-color: #f3f6f7;
    color: #203238;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QLabel {
    color: #203238;
}

QLabel#pageTitle {
    font-size: 24pt;
    font-weight: 700;
}

QLabel#subtitle {
    color: #718187;
    font-size: 11pt;
}

QLabel#chartTitle {
    font-size: 13pt;
    font-weight: 600;
    padding: 4px 2px;
}

QFrame#chartCard {
    background-color: #ffffff;
    border: 1px solid #e3eaeb;
    border-radius: 14px;
}

QPushButton {
    min-width: 90px;
    min-height: 38px;
    padding: 0 14px;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton#primaryButton {
    background-color: #2f7f78;
    border: 1px solid #2f7f78;
    color: #ffffff;
}

QPushButton#primaryButton:hover {
    background-color: #286d67;
    border-color: #286d67;
}

QPushButton#secondaryButton {
    background-color: #ffffff;
    border: 1px solid #d5dfe1;
    color: #34494e;
}

QPushButton#secondaryButton:hover {
    background-color: #f0f5f5;
}

QToolBar {
    background-color: #334155;
    border: none;
    border-radius: 8px;
    padding: 4px;
    spacing: 4px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    color: #f8fafc;
    padding: 6px;
}

QToolBar QToolButton:hover {
    background-color: #475569;
}